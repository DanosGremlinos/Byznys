# Copy to .env.local for local development. Never commit real values.

# --- Database (Neon) ---
# Pooled connection string of the Neon *dev* branch (used by the app).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Auth (Auth.js, single admin) ---
# Random secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
ADMIN_EMAIL=you@example.com
# Name shown in the header (optional)
ADMIN_NAME=
# scrypt hash of the admin password: `npm run hash-password -- 'your-password'`
ADMIN_PASSWORD_HASH=
# Additional users with the same full access (optional), JSON array:
# ADMIN_USERS=[{"name":"Vitek","email":"vitek@example.cz","passwordHash":"scrypt:…"}]
ADMIN_USERS=

# --- Cron (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=

# --- AI (email drafting, reply classification, score explanations) ---
ANTHROPIC_API_KEY=

# --- Leads ---
GOOGLE_PLACES_API_KEY=
# PageSpeed Insights API key (can be the same Google Cloud key with the API enabled)
PAGESPEED_API_KEY=

# --- File storage (Builder assets) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Mailgun, EU region). In development emails are only logged. ---
# EMAIL_PROVIDER=log (default: nothing is delivered) | mailgun
EMAIL_PROVIDER=log
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU region by default; set https://api.mailgun.net for US domains
MAILGUN_BASE_URL=https://api.eu.mailgun.net
# 1 = Mailgun test mode (accepted by Mailgun, not delivered)
MAILGUN_TEST_MODE=1
# Signs inbound/event webhooks (Mailgun → Settings → Webhooks → HTTP webhook signing key)
MAILGUN_WEBHOOK_SIGNING_KEY=
EMAIL_FROM="Jméno Příjmení <info@example.cz>"
# Secret used to sign unsubscribe links
UNSUBSCRIBE_SECRET=
# Public base URL of the app (used in unsubscribe links), e.g. https://byznys.example.cz
APP_URL=

# --- Your company details used in the contract template ---
PROVIDER_NAME=
PROVIDER_ICO=
PROVIDER_ADDRESS=
PROVIDER_CITY=
