# Copy to .env.local for local development. Never commit real values.

# --- Database (Neon) ---
# Pooled connection string of the Neon *dev* branch (used by the app).
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Auth (Auth.js, single admin) ---
# Random secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
ADMIN_EMAIL=you@example.com
# scrypt hash of the admin password: `npm run hash-password -- 'your-password'`
ADMIN_PASSWORD_HASH=

# --- Cron (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ---
CRON_SECRET=

# --- AI (email drafting, reply classification, score explanations) ---
ANTHROPIC_API_KEY=

# --- Leads ---
GOOGLE_PLACES_API_KEY=
# PageSpeed Insights API key (can be the same Google Cloud key with the API enabled)
PAGESPEED_API_KEY=

# --- File storage (Builder assets) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Mailgun, EU region). In development emails are only logged. ---
# EMAIL_PROVIDER=log | mailgun
EMAIL_PROVIDER=log
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
EMAIL_FROM="Jméno Příjmení <info@example.cz>"
# Secret used to sign unsubscribe links
UNSUBSCRIBE_SECRET=
